# Deputat – developer shortcuts (requires uv; Docker targets require docker compose)

ENV_FILE := $(if $(wildcard .env),--env-file .env,)
PORT ?= 8000

help:
	@echo "make dev            – dev server with reload (reads .env if present)"
	@echo "make test           – full test suite"
	@echo "make test-core      – calculation core tests only"
	@echo "make e2e            – Playwright smoke tests (installs Chromium on first run)"
	@echo "make migrate        – alembic upgrade head"
	@echo "make revision m=... – new autogenerated migration"
	@echo "make build          – docker image deputat:latest"
	@echo "make up / down      – docker compose up -d / down"
	@echo "make backup         – run a backup now (inside the container)"

dev:
	uv run $(ENV_FILE) uvicorn app.main:app --reload --port $(PORT)

test:
	uv run pytest

test-core:
	uv run pytest tests/core -q

# Browser smoke tests (tests/e2e); not part of `make test`. Extra flags: make e2e args="--headed --slowmo 300"
e2e:
	uv run playwright install chromium
	uv run pytest -m e2e $(args)

migrate:
	uv run $(ENV_FILE) alembic upgrade head

revision:
	uv run $(ENV_FILE) alembic revision --autogenerate -m "$(m)"

build:
	docker build -t deputat:latest .

up:
	docker compose up -d

down:
	docker compose down

logs:
	docker compose logs -f deputat

# Consistent SQLite snapshot into /data/backups.
backup:
	docker compose exec deputat python -c "from app.services.backup import create_backup; print(create_backup())"

