# Deputat – example environment. Copy to .env and adjust. Never commit .env.
#
# There is no login: external access is protected by Cloudflare Access, the LAN is deliberately open
# (see DEPLOY.md). The only credential is the Bearer token for /api/sensors, created
# in the settings screen (only its SHA-256 hash is stored in the database).

# Signing secret for the CSRF session cookie, 32+ random characters.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a secret is generated once and stored in DATA_DIR/.app_secret.
APP_SECRET=change-me-to-a-long-random-string

# Data directory (SQLite DB, backups, reports, exports, imports). In Docker: /data
DATA_DIR=./data
# DATABASE_URL defaults to sqlite:///$DATA_DIR/deputat.sqlite
# DATABASE_URL=

# Nightly backup (cron syntax, Europe/Berlin; before the 01:00 VM backup) and retention in days.
BACKUP_CRON=30 0 * * *
BACKUP_RETENTION_DAYS=14

# Public URL. All absolute URLs are built from it. With https://, pages opened via plain http in the LAN
# show a dismissible hint linking to it (service worker / offline timer and app installation need https).
BASE_URL=http://localhost:8000

# Secure flag of the session cookie: false (default) | auto (Secure when BASE_URL is https) | true.
# The cookie only carries the CSRF token and flash messages (there is no login). A Secure cookie never
# reaches plain-http clients, so with true/auto every form POST from http://<LAN host> fails with 403.
# Use auto/true only if the app is reached exclusively via https.
# COOKIE_SECURE=false

# Accepted Host headers (DNS-rebinding protection), comma-separated, without port.
# Default: host of BASE_URL plus testserver. localhost, 127.0.0.1 and ::1 are always accepted
# (container healthcheck). Other hosts get 400.
# ALLOWED_HOSTS=time.bauer.center

# Peer networks of the reverse proxy whose X-Real-IP header is used as client address in the
# access log (logging only, never for trust decisions). Comma-separated CIDRs.
# PROXY_TRUSTED_NETS=172.16.0.0/12

LOG_LEVEL=info

# Ferienkatalog (amtliche Ferientermine Bayern). Default: config/ferien_bayern.yaml im Image.
# Für eine aktualisierte Datei im Datenvolume:
# FERIEN_CATALOG_FILE=/data/ferien_bayern.yaml

# CSRF protection (keep true outside tests).
# CSRF_ENFORCE=true
# Lifetime of the CSRF session cookie in seconds (default 30 days).
# SESSION_MAX_AGE=2592000
